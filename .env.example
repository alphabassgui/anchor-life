# Anchor Life — Environment Variables (TASK-001)
# Copy this file to `.env.local` and fill in real values. Never commit `.env.local`.

# --- Supabase (PostgreSQL + Auth) ---
# Public: safe to expose to the browser client.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Secret: SERVER-ONLY. Never expose to browser clients (AGENTS.md §3.4).
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# --- Upstash Redis (Ephemeral venue presence) ---
# REST credentials used by @upstash/redis for stateless presence polling.
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"
